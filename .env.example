# SMTP credentials for the contact form (Nodemailer).
# Copy this file to .env.local for local development and set the same
# variables in the Vercel project dashboard for preview/production.
#
# === Gmail setup (recommended for low volume, ~500 emails/day) ===
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
# 3. Paste the 16-char App Password (no spaces) into SMTP_PASS below.
# 4. SMTP_FROM must be the same Gmail address (Gmail rewrites the From
#    if you try to send "as" another domain).
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=vijay.itplcloud@gmail.com
# SMTP_PASS=replace-with-16-char-app-password
# SMTP_FROM="ITPL Cloud Website <vijay.itplcloud@gmail.com>"
#
# === Generic SMTP (any other provider) ===
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false           # true for port 465, false for 587/STARTTLS
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="ITPL Cloud Website <noreply@inclusionetechnologies.com>"

# Where contact form submissions are delivered.
CONTACT_TO=info@inclusionetechnologies.com

# Tawk.to live chat widget. Find these in your tawk.to dashboard under
# Admin → Property → Chat Widget. The embed URL looks like
# https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>.
# Both must be NEXT_PUBLIC_* because the widget runs in the browser.
# Leave blank to disable the chat widget entirely.
NEXT_PUBLIC_TAWK_PROPERTY_ID=6a15550b7544131c36fe5cfa
NEXT_PUBLIC_TAWK_WIDGET_ID=1jphl8dqn
